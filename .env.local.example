# Supabase 설정
# 실제 값은 Supabase Dashboard > Project Settings > API 에서 확인

# Project URL (이미 확인됨)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon (public) key - Dashboard에서 복사하여 붙여넣기
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에_anon_key를_붙여넣으세요

# 서버 전용: 거래소 API 키 암호화용 32바이트 base64 키
# 생성 예: openssl rand -base64 32
EXCHANGE_ENCRYPTION_KEY=여기에_암호화키를_붙여넣으세요
EXCHANGE_ENCRYPTION_KEY_ID=primary

# 서버 전용: 키 회전 시 이전 키를 JSON으로 보관
# 예: {"primary":"old_base64_key","2026-05":"new_base64_key"}
EXCHANGE_ENCRYPTION_KEYRING=
